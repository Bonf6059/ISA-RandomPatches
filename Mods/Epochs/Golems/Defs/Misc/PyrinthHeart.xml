<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- Pyrinth heart  -->

    <ThingDef ParentName="DV_GolemBodypart_Implant">
        <defName>ISA_Golem_PyrinthHeart</defName>
        <label>pyrinth heart</label>
        <description>An heart made of pyrinth shards locked between anima branches. Increases min comfortable temperature at the cost of making the golem more brittle.</description>
        <descriptionHyperlinks>
            <RecipeDef>ISA_Golem_InstallPyrinthHeart</RecipeDef>
        </descriptionHyperlinks>
        <statBases>
            <MarketValue>100</MarketValue>
            <Mass>1</Mass>
        </statBases>
        <costList>
            <DV_AnimaLog>40</DV_AnimaLog>
            <DV_Pyrinth>25</DV_Pyrinth>
        </costList>
        <recipeMaker>
            <researchPrerequisite>DV_GolemResearch_GolemancyModules</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <HediffDef>
        <defName>ISA_Golem_InstalledPyrinthHeart</defName>
        <label>Pyrinth heart</label>
        <description>An heart made of pyrinth shards locked between anima branches. Increases min comfortable temperature at the cost of making the golem more brittle.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(171, 245, 216)</defaultLabelColor>
        <makesSickThought>false</makesSickThought>
        <tendable>false</tendable>
        <priceImpact>false</priceImpact>
        <isBad>False</isBad>
        <spawnThingOnRemoved>ISA_Golem_PyrinthHeart</spawnThingOnRemoved>
        <stages>
            <li>
		        	<statFactors>
				        <IncomingDamageFactor>1.1</IncomingDamageFactor>
			          <ComfyTemperatureMin>1.5</ComfyTemperatureMin>
              </statFactors>
            </li>
        </stages>
        <comps>
        </comps>
    </HediffDef>

    <RecipeDef ParentName="DV_GolemBodypart_Install">
        <defName>ISA_Golem_InstallPyrinthHeart</defName>
        <label>attach pyrinth heart</label>
        <description>Attach a pyrinth heart.</description>
        <descriptionHyperlinks>
            <ThingDef>ISA_Golem_PyrinthHeart</ThingDef>
        </descriptionHyperlinks>
        <jobString>Attaching pyrinth heart.</jobString>
        <effectWorking>ClayTurning</effectWorking>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>ISA_Golem_PyrinthHeart</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>ISA_Golem_PyrinthHeart</li>
            </thingDefs>
        </fixedIngredientFilter>
        <appliedOnFixedBodyParts>
            <li>DV_Golem_Torso</li>
        </appliedOnFixedBodyParts>
        <addsHediff>ISA_Golem_InstalledPyrinthHeart</addsHediff>
    </RecipeDef>

</Defs>
